{
  "title": "SWIM dNOTAM \u2014 Distributed Tracing Demo",
  "uid": "swim-sfg-demo",
  "version": 2,
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "swim",
    "dnotam",
    "observability"
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "DNOTAM Dispatches",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(dnotam_dispatches_total)",
          "legendFormat": "dispatches",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "DNOTAM Publishes",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(dnotam_publishes_total)",
          "legendFormat": "publishes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Validation Failures",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "uid": "loki",
        "type": "loki"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\"dnotam.*\"} |= \"VALIDATION_FAILURE\" [15m]))",
          "legendFormat": "failures",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg Dispatch Duration",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 200
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(dnotam_dispatch_duration_sum[1m]) / rate(dnotam_dispatch_duration_count[1m])",
          "legendFormat": "avg ms",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Dispatch Errors",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(dnotam_dispatch_errors_total) or vector(0)",
          "legendFormat": "errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Service Map \u2014 connections via Prometheus",
      "description": "Service edges from traces_service_graph_request_total (Tempo metrics_generator)",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "uid": "prometheus",
            "type": "prometheus"
          },
          "expr": "sum by (client, server, connection_type) (increase(traces_service_graph_request_total[15m]))",
          "instant": true,
          "format": "table",
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "client",
                "server",
                "connection_type",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "requests (15m)"
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "requests (15m)",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "requests (15m)"
            },
            "properties": [
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent Traces",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "uid": "tempo",
        "type": "tempo"
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{.service.name =~ \"dnotam.*\"}",
          "refId": "A",
          "limit": 20
        }
      ],
      "options": {
        "sortBy": []
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceID"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in Explore",
                    "internal": {
                      "query": {
                        "query": "${__value.raw}",
                        "queryType": "traceql"
                      },
                      "datasourceUid": "tempo",
                      "datasourceName": "Tempo"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Validation Failures",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "uid": "loki",
        "type": "loki"
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "expr": "{service_name=~\"dnotam.*\"} |= \"VALIDATION_FAILURE\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "All Service Layer Events",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "uid": "loki",
        "type": "loki"
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "expr": "{service_name=~\"dnotam.*\"} |= \"SERVICE_LAYER\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Dispatch & Publish Rate",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "rate(dnotam_dispatches_total[1m])",
          "legendFormat": "dispatches/s (originator)",
          "refId": "A"
        },
        {
          "expr": "rate(dnotam_publishes_total[1m])",
          "legendFormat": "publishes/s (publisher)",
          "refId": "B"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": []
}